# Copy to .env for local runs. Never commit .env.
# On Modal these come from the secret "gspaenli-app".

# OpenAI-compatible endpoint (our Modal vLLM app, or any other provider)
LLM_BASE_URL=https://vvanloo1--gspaenli-llm-serve.us-east.modal.run/v1
LLM_API_KEY=
MODEL_ID=swiss-ai/Apertus-8B-Instruct-2509
# Set to false if the endpoint does not support response_format json_schema
LLM_JSON_SCHEMA=true

# Where the Swiss MCP is checked out (scripts/fetch_mcp.sh)
MCP_DIR=vendor/swiss-ai-week-mcp
